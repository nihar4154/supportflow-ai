{
  "uid": "supportflow-email",
  "title": "SupportFlow email operations",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=~\"support-agent|support-mcp-server\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Completed email attempts since agent start",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (support_email_handle_seconds_count)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Mean email handling time over 5 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(support_email_handle_seconds_sum[5m])) / sum(rate(support_email_handle_seconds_count[5m]))",
          "legendFormat": "Handling time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean stage duration over 5 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(support_email_resolve_seconds_sum[5m])) / sum(rate(support_email_resolve_seconds_count[5m]))",
          "legendFormat": "resolve",
          "refId": "A"
        },
        {
          "expr": "sum(rate(support_email_reply_seconds_sum[5m])) / sum(rate(support_email_reply_seconds_count[5m]))",
          "legendFormat": "reply",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "MCP calls by tool and outcome",
      "description": "Estimated completed calls in the selected time range, ranked by total volume.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (increase(mcp_tool_call_seconds_count{job=\"support-mcp-server\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "Tool",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "tool",
            "columnField": "outcome",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "tool\\outcome": "Tool"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum",
              "include": [
                "success",
                "error"
              ]
            },
            "alias": "Total"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Total": true
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "MCP failures by tool and exception",
      "description": "Estimated failures in the selected time range, ranked by tool and exception.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(label_join((sum by (tool, error) (increase(mcp_tool_call_seconds_count{job=\"support-mcp-server\",outcome=\"error\"}[$__range]))) > 0, \"cause\", \" \u00b7 \", \"tool\", \"error\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "xField": "Tool \u00b7 exception",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "cause",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "cause": "Tool \u00b7 exception",
              "Value": "Failures"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Mean MCP execution time by tool",
      "description": "Rolling mean server-side duration per tool. Gaps indicate intervals without completed calls.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(mcp_tool_call_seconds_sum{job=\"support-mcp-server\"}[$__rate_interval])) / (sum by (tool) (rate(mcp_tool_call_seconds_count{job=\"support-mcp-server\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Model tokens by direction",
      "description": "Estimated input and output tokens used during the selected time range.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (increase(gen_ai_client_token_usage_total{job=\"support-agent\",gen_ai_token_type=~\"input|output\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "vertical",
        "stacking": "none",
        "xField": "Model",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "gen_ai_request_model",
            "columnField": "gen_ai_token_type",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "gen_ai_request_model\\gen_ai_token_type": "Model"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Runtime logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"support-agent|support-mcp-server\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}
